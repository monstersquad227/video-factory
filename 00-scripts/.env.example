# ===== 阿里云百炼必填项 =====
# API Key（控制台获取，切勿提交到仓库）。Token Plan 套餐密钥以 sk-sp- 开头
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容网关 Base URL（脚本生成走 /chat/completions）
# 与 01-voice / 02-image / 03-video 使用同一个 Token Plan 网关即可
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ===== 脚本生成参数（留空则用代码默认值）=====
# LLM 模型。注意：Token Plan 网关不提供通用名 qwen-plus，实测可用的对话模型有：
#   qwen3.6-plus / qwen3.7-plus / qwen3.6-flash / qwen3.8-flash / qwen3.7-max / qwen3.8-max / qwen4-max
# 默认用 qwen3.6-plus（非思考模式，JSON 输出稳定）；追求质量可用 qwen3.7-plus/qwen4-max
SCRIPTS_MODEL=qwen3.6-plus
# 采样温度（越高越有创意，也越不稳定）
SCRIPTS_TEMPERATURE=0.7
# 单次请求读取超时（秒）
SCRIPTS_TIMEOUT=180
# 网络/5xx/429 的额外重试次数
SCRIPTS_MAX_RETRIES=2
# 结构校验失败时回灌模型修复的最大次数
SCRIPTS_MAX_REPAIR=2
