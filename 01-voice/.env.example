# ===== 阿里云百炼必填项 =====
# API Key（控制台获取，切勿提交到仓库）。Token Plan 套餐密钥以 sk-sp- 开头
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接入点（以下二选一）：
# 方式 A：Token Plan 网关 —— 直接填 Base URL（推荐；TTS 会自动改用 /api/v1/services/audio/tts/SpeechSynthesizer）
DASHSCOPE_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 方式 B：标准百炼网关 —— 填业务空间 Workspace ID（拼接 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com）
# DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxxxxxxxxxx
# 接入区域：cn-beijing（华北2·北京，默认） / ap-southeast-1（新加坡）；仅方式 B 生效
DASHSCOPE_REGION=cn-beijing

# ===== 可选：语音合成参数（留空则使用代码默认值）=====
# 模型名称
TTS_MODEL=qwen-audio-3.0-tts-plus
# 音色 ID。Token Plan 实测可用：longanlingxin（女·知心温暖）/ longanlufeng（男）/ longanhuan_v3.6 / longanlingxi
# 注意：音色需与模型版本匹配，不匹配会返回 400 [cosyvoice:]Engine error [411]
TTS_VOICE=longanlingxin
# 音频格式：mp3（默认） / wav / pcm / opus
TTS_FORMAT=mp3
# 采样率 Hz：8000/12000/16000/22050/24000（默认）/44100/48000
TTS_SAMPLE_RATE=24000
# 语速 0.5-2.0（默认 1.0）
TTS_RATE=1.0
# 音量 0-100（默认 50）
TTS_VOLUME=50
# 音调 0.5-2.0（默认 1.0）
TTS_PITCH=1.0
# 情绪 / 风格 / 方言 自然语言指令（qwen-audio-3.0-tts-plus 通过 instruction 控制）
# 也可直接在文本中内嵌情感标签，如 [excited] [sad] [whispers] [laughing]
TTS_INSTRUCTION=用温柔自然的女性旁白，语速适中，情绪平和
# 随机种子 0-65535（留空则不传，相同种子+参数可复现同一结果）
# TTS_SEED=0
# 目标语种提示（逗号分隔，当前仅取第一个），如 zh / en；用于数字、符号发音异常时
# TTS_LANGUAGE_HINTS=zh
