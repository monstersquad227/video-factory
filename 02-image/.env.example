# ===== 阿里云百炼必填项 =====
# API Key（控制台获取，切勿提交到仓库）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 接入点（可选）=====
# 方式 A：显式 Base URL。若填写的是 compatible-mode 地址，本服务仍会改用图像生成原生 /api/v1 路径。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# 方式 B：业务空间专属域名。
# DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxxxxxxxxxx
# DASHSCOPE_REGION=cn-beijing

# ===== 图像生成参数（留空则使用代码默认值）=====
IMAGE_MODEL=wan2.7-image-pro
# 输出尺寸：1K / 2K / 4K，或 WIDTHxHEIGHT、WIDTH*HEIGHT。
# 文生图总像素需在 768*768 至 4096*4096 之间，宽高比需在 1:8 至 8:1 之间。
IMAGE_SIZE=2K
# 是否添加“AI生成”水印
IMAGE_WATERMARK=false
# 是否开启思考模式；开启质量更好，但耗时更长
IMAGE_THINKING_MODE=true
# 随机种子 0-2147483647（留空则不传）
# IMAGE_SEED=42

# ===== 超时与重试（可选）=====
# 单次 HTTP 请求读取超时（秒）
IMAGE_REQUEST_TIMEOUT=120
# 单个生图任务轮询总超时（秒）
IMAGE_TASK_TIMEOUT=600
# 任务轮询间隔（秒）
IMAGE_POLL_INTERVAL=5
# 图片下载超时（秒）
IMAGE_DOWNLOAD_TIMEOUT=120
# 创建任务、查询任务、下载图片和任务失败时的额外重试次数
IMAGE_MAX_RETRIES=2
IMAGE_RETRY_BACKOFF=2
