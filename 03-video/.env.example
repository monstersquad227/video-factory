# ===== 阿里云百炼必填项 =====
# API Key（控制台获取，切勿提交到仓库）。Token Plan 套餐密钥以 sk-sp- 开头
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 接入点（二选一，需与模型所属地域一致）=====
# 方式 A：业务空间专属域名（推荐用于视频生成原生接口）
#   端点将拼接为 https://{WorkspaceId}.{region}.maas.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
DASHSCOPE_WORKSPACE_ID=ws-xxxxxxxxxxxxxxxx
# 方式 B：显式 Base URL。本服务只取其 scheme+host，再拼接视频生成原生路径。
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# 接入区域：cn-beijing（默认）/ ap-southeast-1 / ap-northeast-1 / eu-central-1 / us-east-1 / cn-hongkong
DASHSCOPE_REGION=cn-beijing
# 注意：wan3.0-video 的可用性与地域/套餐相关。若使用 Token Plan（sk-sp-）密钥调用报
#   InvalidApiKey / ModelNotFound，请确认该网关是否放通 video-synthesis，或改用标准百炼网关
#   （填 DASHSCOPE_WORKSPACE_ID）。跨地域调用会失败，请保证 模型 / URL / API Key 同地域。

# ===== 视频生成参数（留空则使用代码默认值）=====
VIDEO_MODEL=wan3.0-video
# 分辨率档位：480P / 720P / 1080P
VIDEO_RESOLUTION=1080P
# 宽高比：adaptive / 21:9 / 16:9 / 4:3 / 1:1 / 3:4 / 9:16（竖屏用 9:16）
VIDEO_RATIO=9:16
# 单镜头生成时长上限（秒）。实际请求时长 = clamp(ceil(shot.duration), 2, 本值)，范围 [2,30]
VIDEO_MAX_DUR=5
# 生成片段是否含音轨。建议 false：声音统一由旁白 + BGM 在 step 7 混入
VIDEO_AUDIO=false
# 是否开启 prompt 智能改写（短 prompt 提升明显，略增耗时）
VIDEO_PROMPT_EXTEND=true
# 是否添加水印
VIDEO_WATERMARK=false
# 随机种子 -1 或 [0,2147483647]（留空则不传）
# VIDEO_SEED=42

# ===== 并发 / 超时 / 重试（可选）=====
# 并发任务数（每个任务约 1-5 分钟，按额度与限流调整）
VIDEO_CONCURRENCY=3
# 单次 HTTP 请求读取超时（秒）
VIDEO_REQUEST_TIMEOUT=120
# 单个视频任务轮询总超时（秒）
VIDEO_TASK_TIMEOUT=1200
# 任务轮询间隔（秒，官方建议 ~15）
VIDEO_POLL_INTERVAL=15
# 视频下载超时（秒）
VIDEO_DOWNLOAD_TIMEOUT=300
# 创建任务、查询任务、下载与任务失败时的额外重试次数
VIDEO_MAX_RETRIES=2
VIDEO_RETRY_BACKOFF=3
